// JavaScript program to print BST in given range 

class TreeNode {
    constructor(d) {
        this.data = d;
        this.left = null;
        this.right = null;
    }
}

var root = null;

function sortedArrayToBSTRecur(list, start, end) {
    if (start > end) return null;

    let mid = Math.floor((start + end + 1) / 2);

    // First construct the left subtree, so as to grab the last node in the mid calculation
    let left = sortedArrayToBSTRecur(list, start, mid - 1);

    let root = new TreeNode(list[mid]);
    root.left = left;

    // Then construct the right subtree
    root.right = sortedArrayToBSTRecur(list, mid + 1, end);
    return root;
}

function sortedArrayToBST(arr) {
    return sortedArrayToBSTRecur(arr, 0, arr.length - 1);
}

function bfs(root) {
    if (!root) return [];
    let res = [];
    let queue = [root];

    while (queue.length) {
        let node = queue.shift();

        if (node) res.push(node.data);
        else {
            res.push(null);
            continue;
        }

        // Enqueue left child
        if (node.left) queue.push(node.left);
        else queue.push(null);

        // Enqueue right child
        if (node.right) queue.push(node.right);
        else queue.push(null);
    }

    // Remove trailing null values from array
    while (res[res.length - 1] === null) {
        res.pop();
    }

    console.log(res);
}


var arr = [-10, -3, 0, 5, 9];
var n = arr.length;
root = sortedArrayToBST(arr, 0, arr.length - 1);
console.log("Preorder traversal of constructed BST<br>");
bfs(root);

