{{>header}}
<div class="content">
    <section class="js">
        <h2>JavaScript</h2>
        <div class="articles">
           {{#each js}}
                {{>articleItem}}
            {{else}}
                <h3 class="no-articles">No articles yet</h3>
            {{/each}}
        </div>
    </section>
    <section class="CSharp">
        <h2>C#</h2>
        <div class="articles">
            {{#each csharp}}
                {{>articleItem}}
            {{else}}
                <h3 class="no-articles">No articles yet</h3>
            {{/each}}
        </div>
    </section>
    <section class="Java">
        <h2>Java</h2>
        <div class="articles">
           {{#each java}}
                {{>articleItem}}
            {{else}}
                <h3 class="no-articles">No articles yet</h3>
            {{/each}}
        </div>
    </section>
    <section class="Pyton">
        <h2>Pyton</h2>
        <div class="articles">
            {{#each python}}
                {{>articleItem}}
            {{else}}
                <h3 class="no-articles">No articles yet</h3>
            {{/each}}
        </div>
    </section>
</div>

{{>footer}}