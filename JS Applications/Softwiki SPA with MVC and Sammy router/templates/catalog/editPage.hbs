{{>header}}
<!-- Edit -->
<div class="container">

    <form action="/edit/{{objectId}}" method="PUT">
        <fieldset>
            <legend>Edit article</legend>
            <p class="field title">
                <input type="text" name="title" id="title" value="{{title}}">
                <label for="title">Title:</label>
            </p>

            <p class="field category">
                <select class="category-select" name="category">
                   <option class="category-option" value="js" {{#if isCategoryJs}}selected{{/if}}>JavaScript</option>
                    <option class="category-option" value="csharp" {{#if isCategoryCsharp}}selected{{/if}}>C#</option>
                    <option class="category-option" value="python" {{#if isCategoryPython}}selected{{/if}}>Python</option>
                    <option class="category-option" value="java" {{#if isCategoryJava}}selected{{/if}}>Java</option>
                </select>
                <label for="category">Category:</label>
            </p>

            <p class="field content">
                <textarea name="content" id="content">{{content}}</textarea>
                <label for="content">Content:</label>
            </p>

            <p class="field submit">
                <button class="btn submit" type="submit">Edit</button>
            </p>

        </fieldset>
    </form>
</div>
{{>footer}}