{{> header}}

<h1>Edit Offer</h1>
<p class="message"></p>
<form action="/edit-offer/{{offer.id}}" method="post">
    <div>
        <input type="text" name="productName" value="{{offer.productName}}">
    </div>
    <div>
        <input type="text" name="price" value="{{offer.price}}">
    </div>
    <div>
        <input type="text" name="imageUrl" value="{{offer.imageUrl}}">
    </div>
    <div>
        <textarea name="description">{{offer.description}}</textarea>
    </div>
    <div>
        <input type="text" name="brand" value="{{offer.brand}}">
    </div>
    <div>
        <button>Edit</button>
    </div>
</form>

{{> footer}}