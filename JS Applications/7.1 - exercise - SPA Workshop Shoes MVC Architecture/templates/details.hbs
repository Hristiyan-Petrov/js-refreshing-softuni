{{> header}}

<div class="offer-details">
    <h1>{{offer.brand}} {{offer.productName}}</h1>
    <div class="info">
        <img src="{{offer.imageUrl}}"
            alt="{{offer.brand}}">
        <div class="description">{{offer.description}}
            <br>
            <br>
            <p lass="price">Total buys: {{this.buys}}</p>
            <p class="price">${{offer.price}}</p>
        </div>
    </div>
    <div class="actions">
        {{#if isCreator}}
        <a href="#/edit-offer/{{offer.id}}">Edit</a>
        <a href="#/delete-offer/{{offer.id}}">Delete</a>
        {{else}}

            {{#if isBought}}
                <span>You bought it</span>
            {{else}}
                <a href="/buy/{{offer.id}}" >Buy</a>
            {{/if}}

        {{/if}}
    </div>
</div>

{{> footer}}