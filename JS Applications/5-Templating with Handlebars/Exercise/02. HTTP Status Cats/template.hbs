<!-- Cat li partial -->
<script type="text/x-handlebars" id="cat-li-partial">
        <li>
            <img src="images/{{imageLocation}}.jpg" width="250" height="250" alt="Card image cap">
            <div class="info">
                <button class="showBtn" onclick=showDetails(event)>Show status code</button>
                <div class="status" id="{{id}}">
                    <h4>Status Code: {{statusCode}}</h4>
                    <p>{{statusMessage}}</p>
                </div>
            </div>
        </li>
    </script>

<!-- Cats ul template with presentation logic -->
<script type="text/x-handlebars" id="cats-ul">
        <ul>
            {{#each cats}}
                {{> catPartial}}
            {{/each}}
        </ul>
    </script>