<div class="container">
    {{> header}}
    {{#if hasNoTeam}}
        <a href="/create" class="btn btn-primary m-3">Create Team</a>
    {{else}}
        <p>You have team and cannot add new one.</p>
    {{/if}}
    <h1>Catalog Page</h1>
    <div>
        {{#each teams}}
            {{> team}}
        {{/each}}
    </div>
</div>

{{> footer}}