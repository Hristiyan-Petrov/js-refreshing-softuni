<h1>Browser</h1>
<form action="/cubes" method="get">
    <input type="text" class="search" name="search" placeholder="Search...">
    <input type="number" name="from" class="difficulty" min="1" max="6" placeholder="Difficulty from...">
    <span>-</span>
    <input type="number" name="to" class="difficulty" min="1" max="6" placeholder="Difficulty to...">



    <input type="submit" value="search">

</form>

<form action="/cubes/order">

    <label for="order">Sort By</label>
    <select id="sortingAttribute" name="sortingAttribute" style="width: 15%">
        <option value="" disabled selected>Sort By:</option>
        <option value="name">Name</option>
        <option value="difficultyLevel">Difficulty</option>
    </select>

    <label for="order">Order By</label>
    <select id="sortingDirection" name="sortingDirection" style="width: 15%">
        <option value="" disabled selected>Order By:</option>
        <option value="asc">Ascending</option>
        <option value="desc">Descending</option>
    </select>

        <input type="submit" value="order" style="width: 15%">

    <div class="container">

        {{#each cubes}}
        {{> cubeHomeItem}}

        {{else}}
        <h3 class="italic">Not cubes were found...</h3>

        {{/each}}
    </div>
</form>