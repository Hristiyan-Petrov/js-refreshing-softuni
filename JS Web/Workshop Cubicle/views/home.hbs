<h1>Browser</h1>
<form action="/cubes" method="get">
    <input type="text" class="search" name="search" placeholder="Search...">
    <input type="number" name="from" class="difficulty" min="1" max="6" placeholder="Difficulty from...">
    <span>-</span>
    <input type="number" name="to" class="difficulty" min="1" max="6" placeholder="Difficulty to...">
    <input type="submit" value="search">
</form>

{{#each cubes}}
    {{> cubeHomeItem}}
    	
    {{else}}
    <h3 class="italic">Not cubes were found...</h3>

{{/each}}