<main>
    <section id="edit-page">
        <article class="edit-page-container">
            <form method="post" class="edit-page-form">
                <h2>Edit an ad</h2>

                <label for="headline">Headline:</label>
                <input type="text" id="headline" name="headline" value="{{either headline oldInput.headline}}">

                <label for="location">Location:</label>
                <input type="text" id="location" name="location" value="{{either location oldInput.location}}">

                <label for="companyName">Company name:</label>
                <input type="text" id="companyName" name="companyName" value="{{either companyName oldInput.companyName}}">

                <label for="companyDescription">Company description:</label>
                <input type="text" id="companyDescription" name="companyDescription" value="{{either companyDescription oldInput.companyDescription}}">

                <article class="edit-page-button">
                    <button class="btn-edit-ads">Edit</button>
                </article>
            </form>

            <article class="edit-page-image">
                <img src="/static/img/job.png" alt="image">
            </article>
        </article>
    </section>
</main>