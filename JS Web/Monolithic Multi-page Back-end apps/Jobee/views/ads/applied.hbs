<main>
    <section id="all-ads-page">
        <article class="all-ads-title">
            <h1>Applied ads</h1>
            <article class="all-ads-card-buttons">
                <a class="btn-details" href="/ads">Apply to new ad</a>
            </article>
        </article>

        {{#each ads}}
        {{>ad-item}}
        {{else}}

        <article class="not-available-ads">
            <h1>You have not applied for ads yet.</h1>
        </article>

        {{/each}}

    </section>
</main>