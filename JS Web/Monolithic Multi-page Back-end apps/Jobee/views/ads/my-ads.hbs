<main>
    <section id="all-ads-page">
        <article class="all-ads-title">
            <h1>My ads</h1>
            <article class="all-ads-card-buttons">
                <a href="/ads/new">Create new ad</a>
            </article>
        </article>

        {{#each ads}}
        {{>ad-item}}
        {{else}}

        <article class="not-available-ads">
            <h1>You have not created job ads yet.</h1>
        </article>

        {{/each}}

    </section>
</main>