<header class="header">
    <article class="header-logo">
        <img src="/static/img/logo.png">
    </article>

    {{#if isAuth}}
        <span class="greet">Hello, {{user.email}}</span>
    {{/if}}
    <nav class="header-nav">
        <ul class="header-nav-list">
            <li class="header-nav-list-item active">
                <a href="/" class="header-nav-list-item-link active">Home Page</a>
            </li>

            {{#if isAuth}}
            <!-- Logged users -->
            <li class="header-nav-list-item">
                <a href="/ads" class="header-nav-list-item-link">Apply to ads</a>
            </li>
            <li class="header-nav-list-item">
                <a href="/ads/my-ads" class="header-nav-list-item-link">My ads</a>
            </li>
            <li class="header-nav-list-item">
                <a href="/ads/applied" class="header-nav-list-item-link">Applied Ads</a>
            </li>
            <li class="header-nav-list-item">
                <a href="/ads/create" class="header-nav-list-item-link">Create Ad</a>
            </li>
            <li class="header-nav-list-item">
                <a href="/ads/search" class="header-nav-list-item-link">Search</a>
            </li>
            <li class="header-nav-list-item">
                <a href="/auth/logout" class="header-nav-list-item-link">Logout</a>
            </li>

            {{else}}
            <!-- Guest users -->
            <li class="header-nav-list-item">
                <a href="/ads" class="header-nav-list-item-link">See ads</a>
            </li>
            <li class="header-nav-list-item">
                <a href="/auth/register" class="header-nav-list-item-link">Register</a>
            </li>
            <li class="header-nav-list-item">
                <a href="/auth/login" class="header-nav-list-item-link">Login</a>
            </li>
            {{/if}}

        </ul>
    </nav>
</header>