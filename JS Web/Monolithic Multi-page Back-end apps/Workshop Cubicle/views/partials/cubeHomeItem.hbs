<div class="cube">

    <!-- Hidden input field to send cube ID with form -->
    <input type="hidden" name="cubeIds" value="{{_id}}">

    <img class="cube" src="{{imageUrl}}">
    <p class="name">{{name}}</p>
    <p><span>Difficulty level:</span> {{difficultyLevel}}</p>
    <a class="btn" href="/cubes/details/{{_id}}">Details</a>
    <a class="btn" href="/cubes/{{_id}}/attach">Add accessory</a>
</div>